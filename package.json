{
  "name": "dsh-plugin-cocos-mcp",
  "version": "1.0.0",
  "description": "Drive a live Cocos Creator 3.8.x editor from AI agents via MCP. Reverse-engineered from Cocos Creator's own 3.8.8 editor contract: 111 verified editor messages, zero-dependency stdio server, editor bridge with undo-journal transactions, and an offline prefab/animation editor.",
  "author": "VberAI Internal",
  "license": "MIT",
  "bin": {
    "cocos-mcp": "./hub/bin.js"
  },
  "main": "./hub/bin.js",
  "scripts": {
    "probe": "node hub/bin.js --probe",
    "tools": "node hub/bin.js --print-tools",
    "test": "node --test hub/test/*.test.js hub/src/offline/test/*.test.js",
    "install:extension": "node scripts/install-extension.js",
    "test:e2e": "node test/e2e.js",
    "test:smoke": "node test/tool-smoke.js"
  },
  "files": [
    "hub/",
    "extension/",
    "scripts/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cocos",
    "cocos-creator",
    "game-engine",
    "mcp",
    "modelcontextprotocol",
    "ai-tools",
    "ai-agent",
    "reverse-engineering"
  ],
  "dependencies": {},
  "devDependencies": {},
  "homepage": "https://github.com/Ppppan9/dsh-plugin-cocos-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ppppan9/dsh-plugin-cocos-mcp.git"
  }
}
